{
  "name": "tj-mcp",
  "version": "1.3.0",
  "engines": {
    "node": ">=20"
  },
  "description": "태진 노래방 MCP 서버 - 반주곡 검색",
  "homepage": "https://github.com/ara-hwang/tj-mcp#readme",
  "bugs": {
    "url": "https://github.com/ara-hwang/tj-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tj-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "snapshot-fixture": "npm run build && node scripts/snapshot-fixture.mjs",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ara-hwang/tj-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.33.0"
  }
}
